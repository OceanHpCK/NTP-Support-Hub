PORT=5000

# Chuỗi kết nối PostgreSQL (chỉ dùng khi chạy local với Postgres; production dùng D1)
DATABASE_URL="postgresql://<user>:<password>@localhost:5432/ntp_support_hub?schema=public"

# Khóa bí mật ký JWT — BẮT BUỘC. Sinh chuỗi ngẫu nhiên dài, KHÔNG commit giá trị thật.
# Ví dụ tạo: openssl rand -base64 48
JWT_SECRET="<đặt-chuỗi-ngẫu-nhiên-an-toàn-của-bạn>"

# Tài khoản admin khởi tạo (đặt qua wrangler secret khi deploy, không commit)
ADMIN_USER="<admin-username>"
ADMIN_PASS="<admin-password>"
